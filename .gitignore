.DS_Store
**/.DS_Store

# Go build artifacts (cmd source dirs are kept)
/chrome-testing/gen
/chrome-testing/shoot
/genproto

# Generated gallery bundle (regenerate via chrome-testing/dist.sh)
/chrome-testing/dist/
/chrome-testing/.vendor-cache/

# Screenshots are verification artifacts, regenerated by chrome-testing/snap.sh
