      rect_attribute { rect_yattr { length_percentage_type { value: "469" } quotation_mark_keyword {} } }
      rect_attribute { rect_width_attr { non_negative_length_percentage_type { value: "470" } quotation_mark_keyword {} } }
      rect_attribute { rect_height_attr { non_negative_length_percentage_type { value: "22" } quotation_mark_keyword {} } }
      rect_attribute { presentation_attribute { fill_attr { paint_type { color_type { functional_color { value: "rgb(230,90,30)" } } } quotation_mark_keyword {} } } }
