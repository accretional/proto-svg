(* ============================================================================
   datatype.ebnf — SVG basic data types and shared value grammars.

   Two kinds of rule live here:

   1. Open-domain LEAF types (PascalCase "*Type").  These are listed in
      genproto's `leafTypes` set and SCALARIZED: gluon replaces their body with
      `string value = 1`, and the renderer substitutes representative samples
      from reps.go.  Their bodies below are honest-but-illustrative; they only
      need to parse, because scalarize discards them (and the lexical helpers
      they reference then become unreachable and are pruned).  Per
      CONTEXT_SENSITIVITY Rule 1a, leaves are reserved for genuinely open value
      spaces (numbers, lengths, colors, strings, IRIs); every CLOSED keyword set
      is enumerated as terminals in its own module, never leafed.

   2. STRUCTURED shared value grammars (PaintType, UnitType, ViewBox,
      PreserveAspectRatio, AlphaValue).  These are NOT scalarized; they are real
      sub-grammars the renderer walks.  Their keyword arms are terminals; only
      their open sub-parts (ColorType, UrlType, NumberType) scalarize.

   Reference: https://www.w3.org/TR/SVG2/types.html
   ============================================================================ *)

(* ── Lexical primitives (snake_case; referenced only by leaf bodies, pruned
   after scalarization) ──────────────────────────────────────────────────── *)

non_zero       = "1" ... "9" ;
digit          = "0" ... "9" ;
whole_number   = digit , { digit } ;
hex_digit      = "0" ... "9" | "a" ... "f" | "A" ... "F" ;
uppercase_letter = "A" ... "Z" ;
lowercase_letter = "a" ... "z" ;
letter         = uppercase_letter | lowercase_letter ;
sign           = "+" | "-" ;

name_start_char = letter | "_" ;
name_char       = letter | digit | "-" | "_" | "." ;
name            = name_start_char , { name_char } ;

(* SVG/CSS number: optional sign, fraction, optional exponent *)
fraction = whole_number , [ "." , whole_number ] | "." , whole_number ;
exponent = ( "e" | "E" ) , [ sign ] , whole_number ;
number   = [ sign ] , fraction , [ exponent ] ;

length_unit = "em" | "ex" | "ch" | "rem" | "vw" | "vh" | "vmin" | "vmax"
            | "cm" | "mm" | "Q" | "in" | "pc" | "pt" | "px" ;
angle_unit  = "deg" | "grad" | "rad" | "turn" ;
time_unit   = "s" | "ms" ;

string_char  = " " ... "!" | "#" ... "~" ;
url_char     = "!" ... "~" ;

(* ── Open-domain leaf types (SCALARIZED by genproto) ─────────────────────── *)

(* <number> https://www.w3.org/TR/SVG2/types.html#InterfaceSVGNumber *)
NumberType = number ;

(* <number> ≥ 0 — a non-negative magnitude.  Sign constraints are encoded
   STRUCTURALLY in the CFG (CONTEXT_SENSITIVITY Rule 3.3, "no leading minus"),
   not clamped in the overlay: this body simply omits the `sign` alternative. *)
NonNegativeNumberType = fraction , [ exponent ] ;

(* <integer> *)
IntegerType = [ sign ] , whole_number ;

(* <integer> ≥ 0 (numOctaves) *)
NonNegativeIntegerType = whole_number ;

(* <integer> ≥ 1 (feConvolveMatrix orderX/orderY — a positive kernel order) *)
PositiveIntegerType = non_zero , { digit } ;

(* <length>; unitless = user units (SVG presentation-attribute §4.2 expansion) *)
LengthType = number , [ length_unit ] ;

(* <length> ≥ 0 — non-negative length (radii, widths, stroke-width, …) *)
NonNegativeLengthType = fraction , [ exponent ] , [ length_unit ] ;

(* <percentage> *)
PercentageType = number , "%" ;

(* <length-percentage> *)
LengthPercentageType = LengthType | PercentageType ;

(* <length-percentage> ≥ 0 — non-negative length or percentage *)
NonNegativeLengthPercentageType = NonNegativeLengthType
                                | ( fraction , [ exponent ] , "%" ) ;

(* stroke-miterlimit: a <number> ≥ 1.  Body parses any non-negative number; the
   ≥1 floor is carried by the reps sample set (the bound is documented here, the
   generator never samples below 1). *)
MiterLimitType = fraction , [ exponent ] ;

(* <coordinate> is a <length> in the user coordinate system *)
CoordinateType = number , [ length_unit ] ;

(* <angle>; unitless = degrees in SVG attribute context *)
AngleType = number , [ angle_unit ] ;

(* <time> (SMIL clock fragments use this for unit-suffixed values) *)
TimeType = number , time_unit ;

(* <color> — a STRUCTURED alternation of the three context-free color forms.
   ColorType is NOT scalarized: it is a real oneof the renderer walks.
     - HexColor and FunctionalColor are open LEAVES (an infinite numeric space):
       the #rrggbb hex digits and the rgb()/hsl() numeric components are sampled
       from reps.go.
     - NamedColor is a CLOSED keyword set — the 148 CSS Color Module Level 4
       named colors enumerated IN FULL (CONTEXT_SENSITIVITY Rule 1: every closed
       keyword set is listed as terminals, never approximated as `letter+`). *)
ColorType = HexColor | FunctionalColor | NamedColor ;

(* #rgb / #rgba / #rrggbb / #rrggbbaa — scalarized leaf (hex-digit ranges). *)
HexColor = "#" , hex_digit , hex_digit , hex_digit ,
           [ hex_digit , hex_digit , hex_digit , [ hex_digit , hex_digit ] ] ;

(* rgb()/rgba()/hsl()/hsla() functional forms — scalarized leaf (the numeric
   components are an open space; reps.go supplies well-formed samples). *)
FunctionalColor = ( "rgb(" | "rgba(" | "hsl(" | "hsla(" ) , { url_char } , ")" ;

(* The 148 CSS Color Module Level 4 named colors (the extended keyword set),
   enumerated in full as a closed alternation. *)
NamedColor =
    "aliceblue" | "antiquewhite" | "aqua" | "aquamarine" | "azure" | "beige"
  | "bisque" | "black" | "blanchedalmond" | "blue" | "blueviolet" | "brown"
  | "burlywood" | "cadetblue" | "chartreuse" | "chocolate" | "coral"
  | "cornflowerblue" | "cornsilk" | "crimson" | "cyan" | "darkblue" | "darkcyan"
  | "darkgoldenrod" | "darkgray" | "darkgreen" | "darkgrey" | "darkkhaki"
  | "darkmagenta" | "darkolivegreen" | "darkorange" | "darkorchid" | "darkred"
  | "darksalmon" | "darkseagreen" | "darkslateblue" | "darkslategray"
  | "darkslategrey" | "darkturquoise" | "darkviolet" | "deeppink" | "deepskyblue"
  | "dimgray" | "dimgrey" | "dodgerblue" | "firebrick" | "floralwhite"
  | "forestgreen" | "fuchsia" | "gainsboro" | "ghostwhite" | "gold" | "goldenrod"
  | "gray" | "green" | "greenyellow" | "grey" | "honeydew" | "hotpink"
  | "indianred" | "indigo" | "ivory" | "khaki" | "lavender" | "lavenderblush"
  | "lawngreen" | "lemonchiffon" | "lightblue" | "lightcoral" | "lightcyan"
  | "lightgoldenrodyellow" | "lightgray" | "lightgreen" | "lightgrey"
  | "lightpink" | "lightsalmon" | "lightseagreen" | "lightskyblue"
  | "lightslategray" | "lightslategrey" | "lightsteelblue" | "lightyellow"
  | "lime" | "limegreen" | "linen" | "magenta" | "maroon" | "mediumaquamarine"
  | "mediumblue" | "mediumorchid" | "mediumpurple" | "mediumseagreen"
  | "mediumslateblue" | "mediumspringgreen" | "mediumturquoise"
  | "mediumvioletred" | "midnightblue" | "mintcream" | "mistyrose" | "moccasin"
  | "navajowhite" | "navy" | "oldlace" | "olive" | "olivedrab" | "orange"
  | "orangered" | "orchid" | "palegoldenrod" | "palegreen" | "paleturquoise"
  | "palevioletred" | "papayawhip" | "peachpuff" | "peru" | "pink" | "plum"
  | "powderblue" | "purple" | "rebeccapurple" | "red" | "rosybrown" | "royalblue"
  | "saddlebrown" | "salmon" | "sandybrown" | "seagreen" | "seashell" | "sienna"
  | "silver" | "skyblue" | "slateblue" | "slategray" | "slategrey" | "snow"
  | "springgreen" | "steelblue" | "tan" | "teal" | "thistle" | "tomato"
  | "turquoise" | "violet" | "wheat" | "white" | "whitesmoke" | "yellow"
  | "yellowgreen" ;

(* <IRI>/<FuncIRI>: a fragment, a relative/absolute URL, or url(...) *)
IriType = "#" , name | "url(" , { url_char } , ")" | { url_char } ;

(* <url>: the url(...) functional form *)
UrlType = "url(" , { url_char } , ")" ;

(* <string> *)
StringType = '"' , { string_char } , '"' ;

(* a single character (SMIL accessKey(<char>)) — one code point, not a string. *)
CharType = string_char ;

(* <custom-ident> (filter result names, etc.) *)
CustomIdentType = name ;

(* an XML name / IDREF token (id values, attributeName, fragment targets) *)
XmlNameType = name ;

(* BCP-47 language tag *)
Bcp47Type = name , { "-" , name } ;

(* Whitespace-separated value lists.  These are NO LONGER scalarized leaves —
   their list STRUCTURE is determined and context-free, so the grammar carries it
   as a real `repeated <element>` (genproto's CollapseCommaList rewrites
   `X , { " " , X }` to a repeated field with a " " separator; the renderer
   space-joins the elements).  Only the element leaf stays open. *)

(* whitespace-separated number list (feColorMatrix values, kernelMatrix,
   tableValues, …) — elements may be signed. *)
ListOfNumbersType = NumberType , { " " , NumberType } ;

(* <number-optional-number> (stdDeviation, baseFrequency, radius,
   kernelUnitLength, …) — one or two NON-NEGATIVE numbers (these are all
   magnitudes; the optional second is the y-axis value). *)
NumberOptionalNumberType = NonNegativeNumberType , [ " " , NonNegativeNumberType ] ;

(* stroke-dasharray: a list of NON-NEGATIVE lengths/percentages (a dash length
   is never negative). *)
DasharrayType = NonNegativeLengthPercentageType , { " " , NonNegativeLengthPercentageType } ;

(* SMIL event symbol (begin/end event-value) *)
EventSymbolType = name ;

(* raw character data: the text content of title/desc/text/tspan/style/script/
   metadata/foreignObject (sits between tags, unquoted, no markup) *)
CharacterDataType = { string_char } ;

(* ── Structured shared value grammars (NOT scalarized; rendered) ─────────── *)

(* <alpha-value> ∈ [0,1] — the opacity family (opacity, fill-opacity,
   stroke-opacity, flood-opacity, stop-opacity).  A bounded-decimal interval is a
   REGULAR language, hence context-free, so the [0,1] range lives in the grammar
   (not the overlay): the integer part is exactly "0" or "1", and a "1" may be
   followed only by zeros.  The 0–100% form is the percentage equivalent.  This
   is a scalarized leaf; its reps sample set stays in range by construction. *)
AlphaValue = "0" | "1"
           | "0" , "." , whole_number
           | "1" , "." , { "0" }
           | ( whole_number , "%" ) ;

(* Shared units enum: gradientUnits / patternUnits / maskUnits / clipPathUnits /
   filterUnits / primitiveUnits / *ContentUnits.  Defaults differ per attribute
   and are recorded in the overlay, not the grammar. *)
UnitType = "userSpaceOnUse" | "objectBoundingBox" ;

(* <paint> https://www.w3.org/TR/SVG2/painting.html#SpecifyingPaint — STRUCTURED:
   keyword arms are terminals; only ColorType/UrlType sub-parts scalarize. *)
PaintType     = "none" | "currentColor" | "context-fill" | "context-stroke"
              | ColorType | PaintRef ;
PaintRef      = UrlType , [ PaintFallback ] ;
PaintFallback = "none" | "currentColor" | ColorType ;

(* viewBox = min-x min-y width height (renderer space-joins the four numbers) *)
ViewBox = NumberType , " " , NumberType , " " , NumberType , " " , NumberType ;

(* preserveAspectRatio = <align> [<meetOrSlice>] — a space separates align from
   meetOrSlice ("xMidYMid meet"); bare "xMidYMid" is also valid, so the space
   lives inside the optional group. *)
PreserveAspectRatio = Align , [ " " , MeetOrSlice ] ;
Align       = "none"
            | "xMinYMin" | "xMidYMin" | "xMaxYMin"
            | "xMinYMid" | "xMidYMid" | "xMaxYMid"
            | "xMinYMax" | "xMidYMax" | "xMaxYMax" ;
MeetOrSlice = "meet" | "slice" ;

(* boolean-presence attribute value (autofocus, preserveAlpha, async, defer) *)
BooleanValue = "true" | "false" ;
